# CoinGecko free Demo API key (optional).
# Used only for historical/current USDT->BRL conversion at transaction-entry time.
# Leave unset to run keyless with lower rate limits — every conversion path
# always falls back to a manual BRL override, so a missing key never blocks
# recording a transaction.
# Get a free key at: https://www.coingecko.com/en/developers/dashboard
COINGECKO_API_KEY=

# Port for the Hono API server (default 3000).
PORT=3000

# SESSION_SECRET signs the session cookie (Phase 4, D-04). Required — the
# dev server fails fast at boot if this is missing/empty. Generate a
# strong random value once, e.g.: openssl rand -hex 32
SESSION_SECRET=
